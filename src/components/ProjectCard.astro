---
interface Props {
  title: string;
  description: string;
  url: string;
  icon: string;
  tags: string[];
  status: 'live' | 'wip' | 'planned';
}

const { title, description, url, icon, tags, status } = Astro.props;
const statusLabel = { live: '● Live', wip: '◐ WIP', planned: '○ Planned' };
const statusColor = { live: '#00d4aa', wip: '#f0c040', planned: '#888' };
---
<a href={url} target="_blank" rel="noopener" class="card">
  <div class="card-icon">{icon}</div>
  <div class="card-body">
    <div class="card-header">
      <h3>{title}</h3>
      <span class="status" style={`color: ${statusColor[status]}`}>{statusLabel[status]}</span>
    </div>
    <p>{description}</p>
    <div class="tags">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--text);
    transition: transform 0.2s, border-color 0.2s;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .card-icon {
    font-size: 2rem;
    flex-shrink: 0;
    width: 48px;
    text-align: center;
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  h3 { font-size: 1.15rem; }
  .status { font-size: 0.75rem; white-space: nowrap; }
  p { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.75rem; }
  .tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tag {
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(0, 212, 170, 0.1);
    color: var(--accent);
    border: 1px solid rgba(0, 212, 170, 0.2);
  }
</style>
